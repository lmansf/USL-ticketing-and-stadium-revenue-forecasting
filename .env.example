# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Your FootyStats API key is a PAID credential. A key committed to a public repo
# is someone else's month of requests on your card. If you leak it, rotate it in
# the FootyStats API settings rather than deleting the commit - the commit
# survives in forks and caches.
#
# Leave this empty and the pipeline runs entirely from data/raw_archive/, which
# is how the finished repo works for anyone without a subscription. See
# docs/phases/00-data-access-and-the-clock.md
FOOTYSTATS_API_KEY=

# FootyStats serves the literal key "example" for the English Premier League
# 2018/19 season (season id 1625). Build and test the whole client against this
# before you subscribe - the day you start paying should be the day you point a
# finished client at a different season id.
FOOTYSTATS_EXAMPLE_KEY=example
FOOTYSTATS_EXAMPLE_SEASON_ID=1625
