# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Your FootyStats API key is a PAID credential. A key committed to a public repo
# is someone else's month of requests on your card. If you leak it, rotate it in
# the FootyStats API settings rather than deleting the commit - the commit
# survives in forks and caches.
#
# Leave this empty and the pipeline runs entirely from data/raw_archive/, which
# is how the finished repo works for anyone without a subscription. See
# docs/phases/00-data-access-and-the-clock.md
FOOTYSTATS_API_KEY=

# FootyStats serves the literal key "example" for the English Premier League
# 2018/19 season (season id 1625). Build and test the whole client against this
# before you subscribe - the day you start paying should be the day you point a
# finished client at a different season id.
FOOTYSTATS_EXAMPLE_KEY=example
FOOTYSTATS_EXAMPLE_SEASON_ID=1625

# Phase two: match-day weather from Open-Meteo (free, no key). On by default;
# the example season's weather is archived, so no request is made for it. Set
# this to 0 to turn the stage off. With it on, `make weather` (or the weekly run)
# fetches only what is still missing and archives every response. See
# docs/phases/12-phase-two-weather.md
USL_WEATHER_ENABLED=1

# The season in progress, for the weekly ingest and the freshness check. Set it
# on the machine that runs the Tuesday job; leave it blank for an archive-only
# run. The season's id must be in usl/ref/seasons.csv.
USL_CURRENT_SEASON=

# Which seasons the backfill pulls. Blank means usl/ref/seasons.csv, the USL
# Championship. Point it at usl/ref/seasons.example.csv to run the EPL example
# season the pipeline was built against - tests and demos do exactly that.
USL_SEASONS_CSV=
