# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data: the DuckDB file is a build product, never a source of truth.
# The reference CSVs under usl/ref/ ARE checked in - they are code.
data/*.duckdb
data/*.duckdb.tmp
data/*.duckdb.wal
data/*.duckdb.lock

# NOTE: data/raw_archive/ is deliberately NOT ignored. It is the only copy of
# the source data once the FootyStats subscription lapses, and it cannot be
# regenerated at any price. Commit it.
# See docs/phases/00-data-access-and-the-clock.md

# Scratch response cache (see docs/phases/01-ingest-to-raw.md)
.cache/
data/cache/

# Logs and run metadata
logs/
*.log

# Tableau
tableau/extracts/*.csv
tableau/extracts/*.hyper
tableau/*.twbr
tableau/Logs/

# Local environment. The FootyStats key is a paid credential - never commit it.
# .env.example IS committed and holds the variable names with no values.
.env
.env.local

# OS
.DS_Store
Thumbs.db
